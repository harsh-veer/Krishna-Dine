# ---- Required ----
NODE_ENV=development
PORT=5000
# Local: mongodb://127.0.0.1:27017/krishna_dine   Atlas: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/krishna_dine?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/krishna_dine
# Long random string. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=12h

# ---- URLs (no trailing slash) ----
# Browser origins allowed to call the API (comma separated). Your Vercel URL / custom domain.
CORS_ORIGINS=http://localhost:5173
# Where printed QR codes point: <PUBLIC_MENU_URL>/menu/<token>. Usually the same as the client URL.
PUBLIC_MENU_URL=http://localhost:5173

# ---- Optional ----
# Number of proxies in front of the app (Render/Heroku = 1). Needed for correct rate limiting by IP.
TRUST_PROXY=1
# Force staff to change seeded/temporary passwords on first login (keep true).
FORCE_PASSWORD_CHANGE=true
# Max food image upload size in bytes (default 2 MB).
UPLOAD_MAX_BYTES=2097152
# Restaurant timezone offset in minutes from UTC for reports (IST = 330).
TZ_OFFSET_MINUTES=330

# ---- Payment gateway (optional). Without it UPI payments stay "pending" until staff confirm them. ----
PAYMENT_GATEWAY=none
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- Seed overrides (optional; used by `npm run seed`) ----
# SEED_ADMIN_EMAIL=admin@krishnadine.local
# SEED_ADMIN_PASSWORD=Admin@12345
# SEED_KITCHEN_EMAIL=kitchen@krishnadine.local
# SEED_KITCHEN_PASSWORD=Kitchen@12345
