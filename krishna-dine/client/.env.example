# Public URL of the backend API (no trailing slash). Leave empty in local development:
# Vite proxies /api and /socket.io to VITE_DEV_API_PROXY.
VITE_API_URL=
# Optional: Socket.IO server URL if different from VITE_API_URL.
VITE_SOCKET_URL=
# Local development only: where the Vite dev server forwards API calls.
VITE_DEV_API_PROXY=http://localhost:5000
